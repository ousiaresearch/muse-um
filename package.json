{
  "name": "muse-um",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "meshy:dry-run": "node scripts/meshy-submit.mjs assets/meshy/observatory-armillary.json",
    "meshy:submit": "node scripts/meshy-submit.mjs assets/meshy/observatory-armillary.json --submit",
    "meshy:poll": "node scripts/meshy-poll.mjs",
    "art:palette": "uv run --python 3.12 --with pillow --no-project python scripts/art-palette-report.py",
    "art:tokens": "uv run --python 3.12 --with pillow --no-project python scripts/assert-token-agreement.py",
    "capture": "node scripts/capture-cdp.mjs",
    "measure": "uv run --python 3.12 --with pillow --no-project python scripts/measure-capture.py",
    "sweep": "uv run --python 3.12 --with pillow --no-project python scripts/sweep-rooms.py",
    "sheet:rooms": "uv run --python 3.12 --with pillow --no-project python scripts/compose-room-sheet.py"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "postprocessing": "^6.36.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.11"
  }
}
